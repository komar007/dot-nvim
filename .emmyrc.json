{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "workspace": {
    "ignoreGlobs": [
      ".here_config/**",
      "nvim/**",
      "result/**"
    ]
  },
  "format": {
    "externalTool": {
      "program": "CodeFormat",
      "args": [
        "format",
        "--stdin",
        "--file",
        "${file}",
        "--detect-config"
      ],
      "timeout": 5000
    },
    "externalToolRangeFormat": {
      "program": "CodeFormat",
      "args": [
        "rangeformat",
        "--stdin",
        "--file",
        "${file}",
        "--detect-config",
        "--complete-output",
        "--range-offset",
        "${start_offset}:${end_offset}"
      ],
      "timeout": 5000
    }
  }
}
